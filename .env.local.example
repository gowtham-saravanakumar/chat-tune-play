# No YouTube API key is needed — /api/youtube-search reads YouTube's public
# search results directly, with no key and no daily quota.

# Optional. Leave unset for normal single-server deployment —
# the app connects to its own Socket.IO server on the same origin.
# Only set this if you deliberately split the backend onto a
# different host later.
# NEXT_PUBLIC_SERVER_URL=https://your-backend.example.com
